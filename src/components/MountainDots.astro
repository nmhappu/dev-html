---
// Decorative halftone mountain range for the footer: a grid of dots whose radius follows a
// procedural ridge-line height field, drifting slowly sideways.
---

<div
	class="mountain-dots relative left-1/2 mt-10 h-56 w-screen -translate-x-1/2 sm:h-80"
	aria-hidden="true"
>
	<canvas class="block size-full"></canvas>
</div>

<style is:global>
	/* The mountains bleed to both screen edges; clip the 100vw overshoot caused by the scrollbar. */
	body {
		overflow-x: clip;
	}
</style>

<script>
	const PITCH = 7;
	const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
	const smoothstep = (e0: number, e1: number, v: number) => {
		const t = Math.max(0, Math.min(1, (v - e0) / (e1 - e0)));
		return t * t * (3 - 2 * t);
	};
	const hash = (n: number) => {
		const s = Math.sin(n * 127.1 + 311.7) * 43758.5453;
		return s - Math.floor(s);
	};
	const vnoise = (x: number) => {
		const i = Math.floor(x);
		const f = x - i;
		return lerp(hash(i), hash(i + 1), f * f * (3 - 2 * f));
	};
	// Ridged fractal noise: sharp peaks, 0..1.
	const ridged = (x: number) => {
		let sum = 0;
		let amp = 0.5;
		let freq = 1;
		for (let o = 0; o < 4; o++) {
			sum += amp * (1 - Math.abs(2 * vnoise(x * freq) - 1));
			amp *= 0.5;
			freq *= 2.1;
		}
		return sum;
	};

	const LAYERS = [
		{ base: 0.8, amp: 1.2, scale: 1.2, seed: 3.1, weight: 0.55, fade: 1.3 },
		{ base: 1.0, amp: 1.15, scale: 1.9, seed: 9.7, weight: 1, fade: 1.1 },
	];

	const root = document.querySelector<HTMLElement>(".mountain-dots");
	const canvas = root?.querySelector("canvas");
	const ctx = canvas?.getContext("2d");

	if (root && canvas && ctx) {
		const reducedMq = window.matchMedia("(prefers-reduced-motion: reduce)");
		let reduced = reducedMq.matches;
		let width = 0;
		let height = 0;
		let color = "#888";
		let raf = 0;
		let visible = true;

		const readColor = () => {
			const el = document.createElement("span");
			el.style.color = "var(--color-accent)";
			el.hidden = true;
			root.appendChild(el);
			color = getComputedStyle(el).color;
			el.remove();
		};

		const draw = (time: number) => {
			ctx.clearRect(0, 0, width, height);
			const cols = Math.floor(width / PITCH);
			const rows = Math.floor(height / PITCH);
			const ox = (width - cols * PITCH) / 2 + PITCH / 2;
			const oy = (height - rows * PITCH) / 2 + PITCH / 2;
			const drift = reduced ? 0 : time * 0.012;
			const path = new Path2D();
			for (let r = 0; r < rows; r++) {
				const y = oy + r * PITCH;
				const yn = y / height;
				for (let c = 0; c < cols; c++) {
					const x = ox + c * PITCH;
					const nx = x / 900 + drift;
					let v = 0;
					for (const L of LAYERS) {
						const sky = L.base - ridged(nx * L.scale + L.seed) ** 2.2 * L.amp;
						const d = yn - sky;
						if (d < 0) continue;
						const body = 1 - smoothstep(0, L.fade, d);
						const edge = 1 - smoothstep(0, 0.07, d);
						const grain = 0.8 + 0.2 * vnoise(nx * 55 + yn * 17);
						v = Math.max(v, L.weight * (0.35 * body + 0.65 * edge * body + 0.25 * edge) * grain);
					}
					const rad = PITCH * 0.5 * Math.min(1, v) * 0.95;
					if (rad < 0.4) continue;
					path.moveTo(x + rad, y);
					path.arc(x, y, rad, 0, Math.PI * 2);
				}
			}
			ctx.fillStyle = color;
			ctx.fill(path);
		};

		const resize = () => {
			const rect = root.getBoundingClientRect();
			width = rect.width;
			height = rect.height;
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			canvas.width = Math.floor(width * dpr);
			canvas.height = Math.floor(height * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			draw(performance.now());
		};

		// The field is wide, so redraw at ~30fps.
		let lastDraw = 0;
		const loop = (now: number) => {
			raf = 0;
			if (now - lastDraw >= 33) {
				lastDraw = now;
				draw(now * 0.001);
			}
			schedule();
		};
		const schedule = () => {
			if (!raf && visible && !reduced && !document.hidden) raf = requestAnimationFrame(loop);
		};

		readColor();
		resize();
		new ResizeObserver(resize).observe(root);
		new MutationObserver(() => {
			readColor();
			if (reduced) draw(0);
		}).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
		new IntersectionObserver(([entry]) => {
			visible = entry?.isIntersecting ?? true;
			if (visible) schedule();
		}).observe(root);
		document.addEventListener("visibilitychange", schedule);
		reducedMq.addEventListener("change", (e) => {
			reduced = e.matches;
			draw(0);
			schedule();
		});
		schedule();
	}
</script>
