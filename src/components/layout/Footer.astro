---
import { menuLinks, siteConfig } from "@/site.config";
import MountainDots from "@/components/MountainDots.astro";
---

<footer class="mt-auto w-full pt-20">
	<div
		class="text-muted flex w-full flex-col items-center justify-center gap-y-2 text-center align-top font-semibold sm:flex-row sm:justify-between sm:text-xs"
	>
		<div class="me-0 sm:me-4">
			<span
				class="inline-block -rotate-2 text-3xl font-normal text-[#5c5c5c]"
				style="font-family: 'Sedgwick Ave Display', cursive;"
			>
				{siteConfig.author}
			</span>
		</div>
		<nav aria-label="Footer" class="sm:divide-muted flex gap-x-2 sm:gap-x-0 sm:divide-x">
			{
				menuLinks.map((link) => (
					<a class="hover:text-global-text px-4 py-2 hover:underline sm:py-0" href={link.path}>
						{link.title}
					</a>
				))
			}
		</nav>
	</div>
	<MountainDots />
</footer>
